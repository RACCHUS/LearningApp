# Supabase Configuration
# Get these from https://supabase.com/dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Local Supabase Testing: External OAuth Providers (Optional)
# Used only by the local Supabase CLI (see supabase/config.toml)
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret

