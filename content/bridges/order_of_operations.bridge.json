    "order-of-operations"
  ],
  "sources": [
    {
      "source_id": "openstax-college-algebra-1e-1-1",
      "publisher": "OpenStax, Rice University",
      "title": "College Algebra",
      "section": "1.1 Real Numbers: Algebra Essentials",
      "url": "https://openstax.org/books/college-algebra/pages/1-1-real-numbers-algebra-essentials",
      "license": "CC BY 4.0",
      "rights_posture": "link_only"
    }
  ],
  "teach": [
    {
      "block_id": "ooo-teach-1",
      "text": "When an expression mixes operations, everyone agrees on one order so it has one answer: first anything in brackets, then powers, then multiplication and division, then addition and subtraction.",
      "source_ids": [
        "openstax-college-algebra-1e-1-1"
      ]
    },
    {
      "block_id": "ooo-teach-2",
      "text": "Multiplication and division are done before addition and subtraction even when they come later in the line. In 3 + 4 × 5, do 4 × 5 = 20 first, then 3 + 20 = 23.",
      "source_ids": [
        "openstax-college-algebra-1e-1-1"
      ]
    },
    {
      "block_id": "ooo-teach-3",
      "text": "Brackets change the order on purpose. In (3 + 4) × 5 the bracket is worked out first: 3 + 4 = 7, then 7 × 5 = 35. Operations of the same level go left to right.",
      "source_ids": [
        "openstax-college-algebra-1e-1-1"
      ]
    }
  ],
  "examples": [
    {
      "block_id": "ooo-example-1",
      "text": "3 + 4 × 5: multiply first, 4 × 5 = 20, then add: 3 + 20 = 23.",
      "source_ids": [
        "openstax-college-algebra-1e-1-1"
      ],
      "worked": {
        "template": "add_product",
        "inputs": {
          "a": 3,
          "b": 4,
          "c": 5
        },
        "result": 23
      }
    },
    {
      "block_id": "ooo-example-2",
      "text": "(3 + 4) × 5: bracket first, 3 + 4 = 7, then 7 × 5 = 35.",
      "source_ids": [
        "openstax-college-algebra-1e-1-1"
      ],
      "worked": {
        "template": "product_of_sum",
        "inputs": {
          "a": 3,
          "b": 4,
          "c": 5
        },
        "result": 35
      }
    }
  ],
  "alternate_explanations": [
    {
      "block_id": "ooo-alt-1",
      "text": "Think of 4 × 5 as one tight group, like four bags of five apples. In 3 + 4 × 5 you have 3 loose apples plus those bags (20 apples), so 23 apples in all.",
      "source_ids": [
        "openstax-college-algebra-1e-1-1"
      ]
    }
  ],
  "checks": [
