  "misconceptions": [
    {
      "misconception_id": "ooo-left-to-right",
      "label": "working strictly from left to right",
      "contrast": "Reading order is not working order. Multiplication and division come before addition and subtraction, wherever they sit in the line, unless brackets say otherwise: 5 + 3 × 4 is 5 + 12 = 17, not 8 × 4 = 32.",
      "source_ids": [
        "openstax-college-algebra-1e-1-1"
      ]
    }
