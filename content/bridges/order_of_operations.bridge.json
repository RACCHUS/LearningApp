  "title": "Order of operations",
  "concept_id": "order-of-operations",
  "primary_objective": {
    "objective_id": "algebra.order-of-operations.evaluate",
    "statement": "Work out expressions such as 3 + 4 × 5 or 20 − 12 ÷ 4 by doing brackets, then multiplication and division, then addition and subtraction."
  },
  "locale": "en-US",
  "estimated_minutes": 4,
  "uses_ai": false,
  "builds_on": [],
