  "title": "Adding, multiplying and dividing fractions",
  "concept_id": "fraction-arithmetic",
  "primary_objective": {
    "objective_id": "numeracy.fractions.operate",
    "statement": "Add fractions with a common denominator, multiply fractions, and divide by a fraction by multiplying by its reciprocal, the same rules rational expressions use."
  },
  "locale": "en-US",
  "estimated_minutes": 5,
