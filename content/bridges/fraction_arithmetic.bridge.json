  "misconceptions": [
    {
      "misconception_id": "fra-adds-bottoms",
      "label": "adding the denominators as well as the numerators",
      "contrast": "The bottom of a fraction names the size of the pieces, so it stays the same when you add pieces of that size: 1/4 + 1/4 is 2/4, not 2/8. Make the bottoms match, then add only the tops.",
      "source_ids": [
        "openstax-college-algebra-1e-1-6"
      ]
    }
