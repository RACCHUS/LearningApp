    "fractions"
  ],
  "sources": [
    {
      "source_id": "openstax-college-algebra-1e-1-6",
      "publisher": "OpenStax, Rice University",
      "title": "College Algebra",
      "section": "1.6 Rational Expressions",
      "url": "https://openstax.org/books/college-algebra/pages/1-6-rational-expressions",
      "license": "CC BY 4.0",
      "rights_posture": "link_only"
    }
  ],
  "teach": [
    {
      "block_id": "fra-teach-1",
      "text": "To multiply fractions, multiply the tops together and the bottoms together: 1/2 × 3/4 = 3/8.",
      "source_ids": [
        "openstax-college-algebra-1e-1-6"
      ]
    },
    {
      "block_id": "fra-teach-2",
      "text": "To divide by a fraction, flip it and multiply: 3/4 ÷ 1/2 is 3/4 × 2/1 = 6/4, which is 1.5.",
      "source_ids": [
        "openstax-college-algebra-1e-1-6"
      ]
    },
    {
      "block_id": "fra-teach-3",
      "text": "To add, the bottoms must match first. 1/2 + 1/4: rewrite 1/2 as 2/4, then add the tops: 2/4 + 1/4 = 3/4. Never add the bottoms. Rational expressions follow exactly the same rules with letters in place of numbers.",
      "source_ids": [
        "openstax-college-algebra-1e-1-6"
      ]
    }
  ],
  "examples": [
    {
      "block_id": "fra-example-1",
      "text": "1/2 × 3/4 = 3/8, which is 0.375.",
      "source_ids": [
        "openstax-college-algebra-1e-1-6"
      ],
      "worked": {
        "template": "fraction_multiply",
        "inputs": {
          "a": 1,
          "b": 2,
          "c": 3,
          "d": 4
        },
        "result": "0.375"
      }
    },
    {
      "block_id": "fra-example-2",
      "text": "1/2 + 1/4 = 2/4 + 1/4 = 3/4, which is 0.75.",
      "source_ids": [
        "openstax-college-algebra-1e-1-6"
      ],
      "worked": {
        "template": "fraction_add",
        "inputs": {
          "a": 1,
          "b": 2,
          "c": 1,
          "d": 4
        },
        "result": "0.75"
      }
    }
  ],
  "alternate_explanations": [
    {
      "block_id": "fra-alt-1",
      "text": "Picture a pizza cut into quarters. One quarter plus one quarter is two quarters, half the pizza. The slices stay quarters; adding them never turns them into eighths.",
      "source_ids": [
        "openstax-college-algebra-1e-1-6"
      ]
    }
  ],
